# Bắt buộc cho tìm kiếm (cần truy cập được api.tavily.com)
TAVILY_API_KEY=
# AMR_TAVILY_MAX_RETRIES=3
# AMR_TAVILY_RETRY_SEC=2
# AMR_TAVILY_MAX_RESULTS=5

# LLM: gemini | openai | auto (auto = OpenAI nếu có key, không thì Gemini)
# Nếu Windows có OPENAI_API_KEY cũ/hết quota, đặt gemini để ép dùng Gemini.
AMR_LLM_PROVIDER=gemini

GOOGLE_API_KEY=
# gemini-1.5-flash đã gỡ khỏi API; code tự map sang gemini-flash-latest
AMR_GEMINI_MODEL=gemini-1.5-flash
# AMR_GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite
# AMR_LLM_DELAY_SEC=3
# AMR_LLM_MAX_RETRIES=5

OPENAI_API_KEY=
# AMR_OPENAI_MODEL=gpt-4o-mini

# Checkpointer: memory | sqlite
AMR_CHECKPOINTER=memory

# Streamlit gọi FastAPI thay vì import graph trực tiếp (0=tắt, 1=bật)
AMR_USE_API=0
AMR_API_BASE=http://127.0.0.1:8000
